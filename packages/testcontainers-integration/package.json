{
  "name": "@integration-testing/testcontainers",
  "version": "0.1.0-beta.1",
  "description": "Typed Testcontainers lifecycle for NestJS, Vitest, Jest, and Node.js backends",
  "author": "Roland Salloum",
  "keywords": ["testcontainers", "integration-testing", "nestjs", "vitest", "jest", "docker"],
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "homepage": "https://github.com/RolandSall/testcontainers-integration#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RolandSall/testcontainers-integration.git",
    "directory": "packages/testcontainers-integration"
  },
  "bugs": {
    "url": "https://github.com/RolandSall/testcontainers-integration/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=22.22" },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/esm/index.d.ts",
  "typesVersions": {
    "*": {
      "jest": ["dist/types/esm/jest/index.d.ts"],
      "vitest": ["dist/types/esm/vitest/index.d.ts"],
      "container-resource-map": ["dist/types/esm/container-resource-map.d.ts"]
    }
  },
  "exports": {
    ".": {
      "import": { "types": "./dist/types/esm/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/types/cjs/index.d.ts", "default": "./dist/index.cjs" }
    },
    "./container-resource-map": {
      "import": { "types": "./dist/types/esm/container-resource-map.d.ts", "default": "./dist/container-resource-map.js" },
      "require": { "types": "./dist/types/cjs/container-resource-map.d.ts", "default": "./dist/container-resource-map.cjs" }
    },
    "./vitest": {
      "import": { "types": "./dist/types/esm/vitest/index.d.ts", "default": "./dist/vitest/index.js" }
    },
    "./vitest/project-global-setup": {
      "import": "./dist/vitest/project-global-setup.js"
    },
    "./jest": {
      "import": { "types": "./dist/types/esm/jest/index.d.ts", "default": "./dist/jest/index.js" },
      "require": { "types": "./dist/types/cjs/jest/index.d.ts", "default": "./dist/jest/index.cjs" }
    },
    "./jest/project-global-setup": {
      "import": "./dist/jest/project-global-setup.js",
      "require": "./dist/jest/project-global-setup.cjs"
    },
    "./jest/project-global-teardown": {
      "import": "./dist/jest/project-global-teardown.js",
      "require": "./dist/jest/project-global-teardown.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts src/container-resource-map.ts src/vitest/index.ts src/vitest/project-global-setup.ts src/jest/index.ts src/jest/project-global-setup.ts src/jest/project-global-teardown.ts --format esm,cjs --sourcemap --clean --splitting && tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist/types/esm && bun ../../scripts/prepare-dual-types.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
    ,"test-docker": "RUN_DOCKER_TESTS=true vitest run src/built-in-containers.docker.test.ts"
  },
  "dependencies": {
    "@testcontainers/mssqlserver": "12.1.0",
    "@testcontainers/mongodb": "12.1.0",
    "@testcontainers/postgresql": "12.1.0",
    "@testcontainers/rabbitmq": "12.1.0",
    "testcontainers": "12.1.0",
    "typescript": ">=5.5 <7"
  },
  "peerDependencies": {
    "jest": ">=30 <31",
    "vitest": ">=4 <5"
  },
  "peerDependenciesMeta": {
    "jest": { "optional": true },
    "vitest": { "optional": true }
  }
}
